# Raahat Control — copy this file to admin/.env for local overrides.

# API origin. Leave blank to use the Vite proxy during development.
# In production set the public API origin, e.g. https://raahat-api.onrender.com
VITE_API_URL=

# Optional links shown in the control room.
# Public hospital finder:
VITE_PUBLIC_SITE_URL=
# Hospital staff sign-in page:
VITE_STAFF_SITE_URL=

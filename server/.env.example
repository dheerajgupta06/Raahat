# Raahat API — copy this file to server/.env and adjust for your environment.

NODE_ENV=development
PORT=5000

# Leave blank in development to use the bundled in-memory MongoDB (auto-seeded).
# For persistence, use MongoDB Atlas: mongodb+srv://user:password@cluster.mongodb.net/raahat
MONGODB_URI=

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS and Socket.io.
# Local Vite dev server is always allowed outside production.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed 25 demo hospitals automatically when the database is empty.
DB_AUTO_SEED=true

# Private storage for hospital registration certificates.
# Defaults to server/uploads. Use a persistent disk path when deploying.
UPLOAD_DIR=

# Used only by `npm run create-admin` to create/update the control-room account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
